# Shared secret Genesys sends as x-api-key
GENESYS_API_KEY=change-me-genesys-secret

# OpenAI Realtime
OPENAI_API_KEY=sk-...

# Optional
AI_MODEL=gpt-realtime-mini
AI_VOICE=sage
HOST=0.0.0.0
PORT=8080
DEBUG=true

# VAD: semantic_vad (recommended) or server_vad
# create_response is always enabled in code — do not manually commit on speech_stopped
OPENAI_VAD_TYPE=semantic_vad
OPENAI_VAD_EAGERNESS=medium
